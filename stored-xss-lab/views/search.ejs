<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>ThaiGadget - ค้นหาสินค้า</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@500;600;700&family=Sarabun:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <div class="topbar">
    <a class="logo" href="/labs">Thai<span>Gadget</span></a>
    <div class="lab-tabs">
      <a href="/product">Stored XSS</a>
      <a href="/search" class="active">Reflected XSS</a>
    </div>
    <div class="topbar-links">
      <span class="shield-badge <%= safeMode ? 'on' : 'off' %>">
        <% if (safeMode) { %>&#128274; SAFE_MODE: true<% } else { %>&#9888; SAFE_MODE: false<% } %>
      </span>
      <span>สวัสดี <b><%= user %></b></span>
      <a href="/logger">Cookie Logger</a>
      <a href="/logout">ออกจากระบบ</a>
    </div>
  </div>

  <div class="lab-banner">
    <div class="lab-banner-inner">
      <span>🔍 <b>Reflected XSS lab</b> — the search query below is echoed back with no encoding when SAFE_MODE is off.</span>
      <a href="/labs">&larr; Labs hub</a>
    </div>
  </div>

  <div class="wrap">
    <h3 class="section-title" style="margin-top:24px;">ค้นหาสินค้า</h3>
    <form class="search-form" method="GET" action="/search">
      <div class="search-row">
        <input type="text" name="q" placeholder="ค้นหาสินค้า เช่น หูฟัง, สายชาร์จ..." value="<%= hasQuery ? displayQuery : '' %>">
        <button class="submit" type="submit">ค้นหา</button>
      </div>
    </form>

    <% if (hasQuery) { %>
      <div class="search-results">
        <div class="no-results">
          <span class="icon">🔎</span>
          ไม่พบสินค้าที่ตรงกับ "<%- displayQuery %>"
        </div>
        <div class="search-hint">ลองค้นหาด้วยคำอื่น หรือดูสินค้าทั้งหมดในหน้ารีวิว</div>
      </div>
    <% } %>
  </div>
</body>
</html>
